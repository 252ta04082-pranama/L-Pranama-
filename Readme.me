#include <stdio.h>

int main()
{
    int n, square, sum = 0;

    printf("Enter a number: ");
    scanf("%d", &n);

    square = n * n;

    while(square > 0)
    {
        sum = sum + square % 10;
        square = square / 10;
    }

    if(sum == n)
        printf("Neon number");
    else
        printf("Not a neon number");

    return 0;
}
